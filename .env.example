# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Chỉ dùng trên server, KHÔNG thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mật khẩu vào trang quản lý đơn /admin
ADMIN_PASSWORD=thay-bang-mat-khau-ngau-nhien-dai-it-nhat-32-ky-tu

# Địa chỉ website (dùng cho metadata)
NEXT_PUBLIC_SITE_URL=https://vinatto.vercel.app
